# Startup: paths are relative to this .env file. Existing process variables win.
MCP_CONFIG=projects/insurance-tools/config.local.yaml
# Required: output directory for both client JSON files; same-name files are replaced.
MCP_CLIENT_CONFIG_DIR=projects/insurance-tools/draft
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# Required: trusted identity. No example identity is used in live mode.
MCP_AGENT_NUMBER=
MCP_AUTH_SUBJECT=

# Auth cURLs read these env values; fixed grant/interface values live in auth_curls/*.txt.
ARK_TOKEN_URL=
ARK_CLIENT_ID=
ARK_CLIENT_SECRET=
