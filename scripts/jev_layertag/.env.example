# 仅本目录 .env 生效；相对路径均以本目录为基准。
# 示例问题是合成数据。使用自己的材料时同时更新 INPUT_PATH 和 INPUT_MAP_PATH。
INPUT_PATH=examples/questions.jsonl
INPUT_MAP_PATH=examples/questions-map.json
JEV_TEMPLATE_PATH=templates/layer-tagging.json
OUTPUT_DIR=output

# 完整 URL 直接使用，不拼接路径；模型由此配置覆盖模板 model。
JEV_API_URL=https://emrank.tech/v1/decisions
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.13.0[slow]
JEV_TIMEOUT_SECONDS=300
