# 相对路径始终基于本目录；命令行 > 进程环境变量 > 本文件 > 默认值。
INPUT_PATH=./example-input.jsonl
OUTPUT_DIR=./output
INPUT_ID_COLUMN=id
# 样例使用 text；旧大题库输入使用 turns。
INPUT_TEXT_COLUMN=text

# 模型及算法参数沿用原大工作流。接口使用 OpenAI 兼容地址。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
# 留空表示不发送 dimensions 参数。
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=20
EMBEDDING_TIMEOUT=60
EMBEDDING_EXTRA_BODY={}

CLUSTER_THRESHOLD=0.7
# 留空关闭细簇；命令行可用 --fine-threshold '' 临时关闭。
CLUSTER_FINE_THRESHOLD=0.85
CLUSTER_LINKAGE=complete

SAMPLE_TOTAL=1087
SAMPLE_ALPHA=0.6
# 留空表示不合并长尾簇。
SAMPLE_TAIL_BINS=1,3
# 长尾占最终样本的上限，如 0.30；非长尾不足时少抽。留空不限制，0 排除长尾。
SAMPLE_TAIL_MAX_RATIO=
SAMPLE_SINGLE_MAX_SIZE=20
# 留空表示单簇不设抽样上限。
SAMPLE_CLUSTER_CAP=
SAMPLE_ROUNDING=pps
SAMPLE_SEED=42
