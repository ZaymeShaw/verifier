# 复制为本目录 .env，配置后直接运行 python pipeline.py。
# 所有相对路径以本目录为基准，也支持绝对路径和 ~/。
# INPUT_PATH 为可选评测 Excel；留空/不配置时仅用材料文件，不关联评测。
# OUTPUT_DIR 和 JEV_TEMPLATE_PATH 必填。
INPUT_PATH=evaluations.xlsx
OUTPUT_DIR=output
JEV_TEMPLATE_PATH=templates/answer-classification.json

# 将自己的 evaluations.xlsx、materials.json、materials-map.json 放在本目录。
# 原始材料和字段字典：同时填写；INPUT_PATH 留空时这两项必填。
MATERIALS_PATH=materials.json
MATERIALS_MAP_PATH=materials-map.json

# 以下连接配置必填；pipeline 生成请求后通过原生 curl 逐条发送。
# 完整请求地址，直接使用，不再拼接路径；冒号无需转义。
JEV_API_URL=https://emrank.tech/v1/decisions
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=120

# 最终模型由 JEV_MODEL 指定。

# 评测结论筛选：main=主要展示，all=全部展示分组。
EVAL_AXES_SCOPE=main
# bad=仅“是否问题 tag”为“是”的结论，all=全部成功轴结论。
EVAL_TAGS_SCOPE=bad

# 必填：最终请求使用的模型名，覆盖所选模板中的 model。
JEV_MODEL=typesafe/jev-1.13.0[slow]
