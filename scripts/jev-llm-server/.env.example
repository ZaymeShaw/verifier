# Only this directory's .env is read. Restart the server after editing.
SERVER_HOST=127.0.0.1
SERVER_PORT=8040
SERVER_API_KEY=

# OpenAI-compatible base URL, e.g. https://your-gateway/v1.
# The SDK appends /chat/completions. Do not put that suffix here.
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
# Explicitly sent as enable_thinking; requires upstream support for this field.
# false by default; set true to enable thinking. Restart after editing.
LLM_ENABLE_THINKING=false

# Model comes from each JEV request's model field; no server-side override.
