# 独立供应商，第一版使用 OpenAI-compatible Chat Completions + tools 协议。
# 复制为 .env.tool_loop 后填写；不会读取或修改根 .env 的公共评测模型配置。
# 未配置时可直接使用页面中的脚本演示模式。
TOOL_LOOP_BASE_URL=
TOOL_LOOP_MODEL=
TOOL_LOOP_API_KEY=
# 探活和正式请求共用；按供应商要求填写（部分模型只接受 1）。
TOOL_LOOP_TEMPERATURE=0
# 留空则不传 reasoning_effort，按供应商实际支持填写。
TOOL_LOOP_REASONING_EFFORT=
TOOL_LOOP_REQUEST_TIMEOUT_SECONDS=300
