# Generated from all registered verifier configuration domains. Do not add unregistered variables.
# Copy required local values to .env; never commit .env.

# verifier 使用的 Python 解释器或可执行命令
# type=string; required=false; secret=false; bind=python.executable
PYTHON_EXECUTABLE=

# verifier server 监听地址
# type=string; required=false; secret=false; bind=server.host
VERIFIER_HOST=

# verifier server 监听端口
# type=integer; required=false; secret=false; bind=server.port
VERIFIER_PORT=

# verifier UAT 服务监听地址
# type=string; required=false; secret=false; bind=uat.host
VERIFIER_UAT_HOST=

# verifier UAT 服务监听端口
# type=integer; required=false; secret=false; bind=uat.port
VERIFIER_UAT_PORT=

# Selenium checklist 使用的 ChromeDriver 可执行文件或命令
# type=path; required=false; secret=false; bind=browser.driver_path
CHROMEDRIVER_PATH=

# 临时覆盖公共 LLM provider
# type=string; required=false; secret=false; bind=llm.provider
LLM_PROVIDER=

# 临时覆盖公共 LLM model
# type=string; required=false; secret=false; bind=llm.model
LLM_MODEL=

# 临时覆盖单次 LLM 请求的超时秒数（yaml 默认 600）。对照跑批在自己进程里把它压短，挂起的请求不用等满 10 分钟才切端点
# type=number; required=false; secret=false; bind=llm.request_timeout_seconds
LLM_REQUEST_TIMEOUT_SECONDS=

# 是否流式取回 LLM 回复（默认 true）。false 退回非流式，只在排查中转站不支持 SSE 时用
# type=boolean; required=false; secret=false; bind=llm.stream
LLM_STREAM=

# 临时覆盖公共 LLM base URL
# type=url; required=false; secret=false; bind=llm.base_url
LLM_BASE_URL=

# verifier 默认 DeepSeek API Key
# type=string; required=true; secret=true; bind=llm.api_key
DEEPSEEK_API_KEY=

# 临时覆盖 live_stub 角色的 LLM model
# type=string; required=false; secret=false; bind=llm.role_policies.live_stub.model
LLM_LIVE_STUB_MODEL=

# 备用 LLM 端点 1 的 base URL（主端点不可用时自动降级）
# type=url; required=false; secret=false; bind=llm.fallback_1.base_url
LLM_FALLBACK_1_BASE_URL=

# 备用 LLM 端点 1 的 model
# type=string; required=false; secret=false; bind=llm.fallback_1.model
LLM_FALLBACK_1_MODEL=

# 备用 LLM 端点 1 的 API Key
# type=string; required=false; secret=true; bind=llm.fallback_1.api_key
LLM_FALLBACK_1_API_KEY=

# 备用 LLM 端点 2 的 base URL（主端点与备1不可用时自动降级）
# type=url; required=false; secret=false; bind=llm.fallback_2.base_url
LLM_FALLBACK_2_BASE_URL=

# 备用 LLM 端点 2 的 model
# type=string; required=false; secret=false; bind=llm.fallback_2.model
LLM_FALLBACK_2_MODEL=

# 备用 LLM 端点 2 的 API Key
# type=string; required=false; secret=true; bind=llm.fallback_2.api_key
LLM_FALLBACK_2_API_KEY=

# embedding.enabled=true 时必须提供的百炼 API Key
# type=string; required=false; secret=true; bind=embedding.api_key
# required_when=embedding.enabled==true
BAILIAN_API_KEY=

# 是否启用正式 ContextUnit embedding 能力
# type=boolean; required=false; secret=false; bind=embedding.enabled
EMBEDDING_ENABLED=

# 临时覆盖百炼 embedding model
# type=string; required=false; secret=false; bind=embedding.model
BAILIAN_EMBEDDING_MODEL=

# embedding HTTP 会话是否继承系统代理
# type=boolean; required=false; secret=false; bind=embedding.trust_env_proxy
BAILIAN_EMBEDDING_TRUST_ENV_PROXY=

# Context runtime 数据目录
# type=path; required=false; secret=false; bind=context.data_root
CONTEXT_DATA_ROOT=

# LLM context 记录存储目录
# type=path; required=false; secret=false; bind=context.store_root
CONTEXT_STORE_ROOT=

# 扩展评估轴的模型策略：any=按路由回退能用哪个端点用哪个；same_model=只允许与角色策略同名模型的端点（中转站可不同），同模型都不可用则该轴 failed。只影响扩展评估轴，不影响生产 judge/裁决
# type=string; required=false; secret=false; bind=eval_axes.model_policy
EVAL_AXES_MODEL_POLICY=

# 客户搜索业务源码挂载位置
# type=path; required=true; secret=false; bind=project.resources.source.repository
CLIENT_SEARCH_REPO=

# 客户搜索解析服务地址
# type=url; required=false; secret=false; bind=runtime.services.primary.base_url
CLIENT_SEARCH_BASE_URL=

# 下游客户搜索服务地址
# type=url; required=false; secret=false; bind=runtime.services.dependencies.downstream_search.base_url
CLIENT_SEARCH_DOWNSTREAM_BASE_URL=

# deer-flow 业务源码挂载位置及本地启动根目录
# type=path; required=true; secret=false; bind=project.resources.source.repository
DEERFLOW_REPO=

# deer-flow Gateway 服务地址
# type=url; required=false; secret=false; bind=runtime.services.primary.base_url
DEERFLOW_BASE_URL=

# 营销规划业务源码挂载位置
# type=path; required=true; secret=false; bind=project.resources.source.repository
MARKETTING_PLANNING_REPO=

# 营销规划服务地址
# type=url; required=false; secret=false; bind=runtime.services.primary.base_url
MARKETTING_PLANNING_BASE_URL=

# 营销规划业务源码挂载位置（意图识别项目）
# type=path; required=true; secret=false; bind=project.resources.source.repository
MARKETTING_PLANNING_INTENT_REPO=

# 营销规划意图识别服务地址
# type=url; required=false; secret=false; bind=runtime.services.primary.base_url
MARKETTING_PLANNING_INTENT_BASE_URL=

# policy-search business source and local startup root
# type=path; required=true; secret=false; bind=project.resources.source.repository
POLICY_SEARCH_REPO=

# policy-search service base URL, defaults to http://127.0.0.1:8050
# type=url; required=false; secret=false; bind=runtime.services.primary.base_url
POLICY_SEARCH_BASE_URL=
