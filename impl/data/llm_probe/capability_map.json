{
  "client_search": {
    "boundary": "能力空间以字段定义表为准（可搜字段、操作符、匹配模式、枚举值）：{material://llm_probe/field_definitions_args}\n字段定义表之外的筛选维度不支持，应明确拒绝而不是编造条件。",
    "capability": "用户拿它办的事：用一句自然语言，从客户库（Elasticsearch）里检回正好符合描述的那群客户。\n交付物是给 ES 执行的查询谓词集（字段×操作符×值+组合逻辑）；同一从表的多个条件作用于同一条成员记录。判断达成必须把条件当查询推演：执行后检回的集合恰好是用户描述的人群才算办成。\n语义等价的不同表达算办成；条件互斥致空集、语义放大、语义缩小、编造未表达的条件、丢失已表达的条件都算没办成。",
    "mock_body": {
      "session_id": "mock_session_dyn",
      "source": "mock",
      "trace_id": "mock_trace_dyn",
      "user_id": "mock_user_001",
      "user_text": "{query}"
    },
    "service": {
      "method": "POST",
      "timeout_seconds": 60.0,
      "url": "http://127.0.0.1:8000/api/v1/client_search_query_parse_no_encipher"
    }
  },
  "marketting-planning-intent": {
    "boundary": "支持：单轮营销规划问句的意图识别与必要槽位抽取。意图标签空间：1001=客户画像、1002=队伍画像、1003=达成路径规划、4001=其他。\n不支持：多轮规划过程；生成 SSE 卡片。",
    "capability": "用户拿它办的事：说一句营销规划请求，被分发到正确的处理流程。\n交付物是意图标签+必要槽位，下游按标签路由、按槽位执行；判断达成必须按「照此标签和槽位分发能否正确承接这句请求」推演。\n标签选对且必要槽位完整准确才算办成；标签错路由、槽位缺失或值错都算没办成。",
    "mock_body": {
      "extra_input_params": {
        "agent_args": {
          "conversation_id": "mock_session_dyn",
          "message": {
            "content": "{query}",
            "content_type": "text"
          }
        },
        "args": {
          "contexts": [],
          "extensions": {}
        }
      },
      "org_id": "default_org",
      "session_id": "mock_session_dyn",
      "trace_id": "mock_trace_dyn",
      "user_text": "{query}"
    },
    "service": {
      "method": "POST",
      "timeout_seconds": 60.0,
      "url": "http://127.0.0.1:9006/api/v1/marketing-planning/intent-recognition"
    }
  },
    "policy_search": {
        "boundary": "支持：把自然语言保单筛选意图解析为查询语法树的过滤条件。\n不支持：下游保单列表检索与结果集处理。",
        "capability": "用户拿它办的事：用自然语言筛出正好符合条件的那批保单。\n交付物是可执行的查询语法树（过滤条件组合），由下游保单检索执行；判断达成必须按语法树执行后命中的保单集合是否恰好等于用户意图来推演，不看树的形状。\n语义等价的表达算办成；条件互斥、放大、缩小、编造未表达条件、丢失已表达条件都算没办成。",
        "mock_body": {
            "action_scenario": "policySearch",
            "app_scenario": "policy_search_parse",
            "application_setting": null,
            "extra_input_params": {
                "agent_args": null,
                "args": {
                    "contexts": []
                },
                "policySearchParseArgs": {
                    "agentCode": "A12345678",
                    "currentTime": "2026-08-06 10:30:00",
                    "query": "{query}"
                }
            },
            "history": [],
            "org_id": "verifier-org",
            "org_name": "verifier",
            "scenario": null,
            "session_id": "mock_session_dyn",
            "source": "verifier",
            "token": "",
            "trace_id": "mock_trace_dyn",
            "ts": 1785983400000,
            "user_action": "write",
            "user_id": "verifier-user",
            "user_text": ""
        },
        "service": {
            "method": "POST",
            "timeout_seconds": 120.0,
            "url": "http://127.0.0.1:8050/api/v1/policy-search/policy-search-parse"
        }
    },
    "dashscope-qa": {
        "capability": "用户拿它办的事：问一个事实型问题，得到一句准确、可直接引用的中文答案。\n交付物是答案文本（output.choices[0].message.content），被提问者直接阅读使用；答案事实正确、直接回应所问即算办成。答非所问、事实错误、编造都算没办成。",
        "mock_body": {
            "model": "qwen-turbo",
            "input": {
                "messages": [
                    {
                        "role": "user",
                        "content": "{query}"
                    }
                ]
            },
            "parameters": {
                "result_format": "message",
                "incremental_output": false
            }
        },
        "service": {
            "method": "POST",
            "url": "https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation",
            "response_mode": "sse_last_frame",
            "timeout_seconds": 180.0,
            "headers": {
                "Authorization": "Bearer ${BAILIAN_API_KEY}",
                "X-DashScope-SSE": "enable"
            }
        }
    }
}
