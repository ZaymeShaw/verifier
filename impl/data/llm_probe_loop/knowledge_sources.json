{
  "insurance-tools": {
    "type": "mcp",
    "description": "insurance-qa-agent 的只读查询工具（保单、客户、产品条款、通用问答），按样本请求里的坐席工号授权查询。读法：① 保单/客户数据里的姓名多为密文，记录属于谁看查询条件（按谁查的）和客户号；② 一张保单可有多条险种记录（主险、附加险各一行），附加险行上的产品名字段是整张保单的主险名，险种归属看 main_subsidiary_risks_flag 和 plan_full_name；③ policy_search 的 total 是接口报告的条目数，可能按险种行计、不一定等于保单张数；本页读到的条数等于 total 时结果是全量，去重张数即全部保单数；policy_search 不能翻页；④ field_descriptions 是字段含义说明。",
    "command": "/Users/xiaozijian/WorkSpace/package/insurance_qa_agent/insurance-tools-mcp/.venv/bin/python",
    "args": [
      "-m",
      "itools"
    ],
    "env": {
      "ENV_TYPE": "dev",
      "ITOOLS_AGENT_ID": "pi",
      "ITOOLS_USER_ID": "{request.user_id}",
      "ITOOLS_EMPNO": "{request.empno}",
      "ITOOLS_AGENTNO": "{request.agentno}"
    },
    "tools": [
      "product_knowledge",
      "benefit_info",
      "general_qa",
      "policy_search",
      "customer_search",
      "policy_detail",
      "customer_detail"
    ]
  },
  "local-es": {
    "type": "es",
    "description": "本机测试 ES（docker.elastic.co 7.17.4，无鉴权）：clause_kb 条款测试库、hr_handbook 员工手册",
    "url": "http://127.0.0.1:9200"
  },
  "agno-insurance": {
    "type": "agno",
    "description": "verify-insurance-agno 的 trace 源（agno）",
    "config": {
      "base_url": "http://127.0.0.1:18066",
      "headers": {},
      "poll_attempts": 5,
      "poll_interval_seconds": 0.3,
      "timeout_seconds": 30,
      "sqlite_path": "/private/tmp/langfuse-handoff/real-validation/runtime.db"
    }
  },
  "langfuse-local": {
    "type": "langfuse",
    "description": "verify-insurance-langfuse 的 trace 源（langfuse）",
    "config": {
      "base_url": "http://127.0.0.1:3300",
      "public_key": "${LANGFUSE_PUBLIC_KEY}",
      "secret_key": "${LANGFUSE_SECRET_KEY}",
      "match_field": "metadata.request_trace_id",
      "timeout_seconds": 15,
      "poll_timeout_seconds": 60,
      "poll_interval_seconds": 1,
      "quiet_seconds": 3,
      "max_pages": 20,
      "page_size": 50,
      "content_char_limit": 20000
    }
  }
}
